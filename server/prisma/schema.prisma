generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  ON_REQUEST
  UNAVAILABLE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTATION_SENT
  NEGOTIATION
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SettingGroup {
  CONTACT
  GENERAL
  STATS
  SOCIAL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedEnquiries Enquiry[]              @relation("AssignedStaff")
  statusChanges     EnquiryStatusHistory[] @relation("StatusChanger")

  @@map("users")
}

model Category {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?   @db.Text
  imageUrl      String?   @db.VarChar(1000)
  imagePublicId String?   @db.VarChar(255)
  displayOrder  Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products Product[]

  @@map("categories")
}

model Brand {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  logoUrl      String?   @db.VarChar(1000)
  logoPublicId String?   @db.VarChar(255)
  description  String?   @db.Text
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products Product[]

  @@map("brands")
}

model Product {
  id                   String             @id @default(uuid())
  name                 String
  slug                 String             @unique
  categoryId           String
  brandId              String?
  shortDescription     String?            @db.Text
  fullDescription      String?            @db.LongText
  primarySpecification String?            @db.VarChar(255)
  availableUnits       String?            @db.VarChar(255) // Comma-separated: MT,KG,PCS,Bundles
  isFeatured           Boolean            @default(false)
  isActive             Boolean            @default(true)
  displayOrder         Int                @default(0)
  availabilityStatus   AvailabilityStatus @default(AVAILABLE)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  specifications ProductSpecification[]
  variants       ProductVariant[]
  enquiries      Enquiry[]

  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  @@map("products")
}

model ProductImage {
  id            String   @id @default(uuid())
  productId     String
  imageUrl      String   @db.VarChar(1000)
  imagePublicId String?  @db.VarChar(255)
  altText       String?  @db.VarChar(255)
  isPrimary     Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductSpecification {
  id           String  @id @default(uuid())
  productId    String
  specKey      String  @db.VarChar(255)
  specValue    String  @db.VarChar(255)
  displayOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  sku             String?  @db.VarChar(100)
  name            String   @db.VarChar(255)
  diameter        String?  @db.VarChar(100)
  grade           String?  @db.VarChar(100)
  thickness       String?  @db.VarChar(100)
  length          String?  @db.VarChar(100)
  size            String?  @db.VarChar(100)
  weight          String?  @db.VarChar(100)
  finish          String?  @db.VarChar(100)
  isAvailable     Boolean  @default(true)
  additionalSpecs Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  enquiries Enquiry[]

  @@index([productId])
  @@map("product_variants")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  company   String?
  location  String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries Enquiry[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model Enquiry {
  id             String        @id @default(uuid())
  enquiryNumber  String        @unique @db.VarChar(50)
  customerId     String
  productId      String?
  variantId      String?
  quantity       Decimal?      @db.Decimal(12, 3)
  unit           String?       @db.VarChar(50)
  location       String?       @db.VarChar(255)
  message        String?       @db.Text
  sourcePage     String?       @db.VarChar(500)
  status         EnquiryStatus @default(NEW)
  assignedUserId String?
  internalNotes  String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product       Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: SetNull)
  assignedStaff User?                  @relation("AssignedStaff", fields: [assignedUserId], references: [id], onDelete: SetNull)
  statusHistory EnquiryStatusHistory[]

  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@index([assignedUserId])
  @@map("enquiries")
}

model EnquiryStatusHistory {
  id             String        @id @default(uuid())
  enquiryId      String
  previousStatus EnquiryStatus
  newStatus      EnquiryStatus
  changedById    String?
  note           String?       @db.Text
  createdAt      DateTime      @default(now())

  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("StatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([enquiryId])
  @@map("enquiry_status_history")
}

model HeroSlide {
  id                String   @id @default(uuid())
  title             String   @db.VarChar(255)
  subtitle          String?  @db.Text
  bgImageUrl        String   @db.VarChar(1000)
  bgImagePublicId   String?  @db.VarChar(255)
  fgImageUrl        String?  @db.VarChar(1000)
  fgImagePublicId   String?  @db.VarChar(255)
  primaryCtaText    String   @default("Explore Products") @db.VarChar(100)
  primaryCtaLink    String   @default("/products") @db.VarChar(255)
  secondaryCtaText  String?  @default("Request a Quote") @db.VarChar(100)
  secondaryCtaLink  String?  @default("/quote") @db.VarChar(255)
  displayOrder      Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("hero_slides")
}

model WebsiteSetting {
  id        String       @id @default(uuid())
  key       String       @unique @db.VarChar(100)
  value     String       @db.Text
  group     SettingGroup @default(GENERAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("website_settings")
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  subject   String?  @db.VarChar(255)
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}
